MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 178531218}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3da529bf0e244d4fabc4b840868b0c5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  promptFloatingText: {fileID: 1443631684}
  infoDisplayPanel: {fileID: 1612969950}
  infoTitleComponent: {fileID: 1010675287}
  infoTextComponent: {fileID: 1591142480}
  title: Reto final del banco
  educationalContent: "El banco quiere saber si ya est\xE1s lista para manejar tu
    plata sola. Responde las 3 preguntas."
  questions:
  - question: "Tienes una deuda de $400.000 en la tarjeta y te cobran intereses.
      \xBFQu\xE9 te conviene?"
    options:
    - "Pagar solo la cuota m\xEDnima"
    - "Pagar el total o lo m\xE1ximo que pueda"
    - Sacar otra tarjeta para pagar esta
    correctIndex: 1
    whyCorrect: "Pagar el total corta los intereses. La cuota m\xEDnima alarga la
      deuda."
    whyWrong: "Con la cuota m\xEDnima o con otra tarjeta la deuda crece por los intereses."
  - question: "\xBFPara qu\xE9 sirve el fondo de emergencia?"
    options:
    - Para aprovechar descuentos
    - "Para imprevistos: una enfermedad, un da\xF1o o quedarse sin trabajo"
    - Para salir los fines de semana
    correctIndex: 1
    whyCorrect: "As\xED es: es tu colch\xF3n para lo inesperado."
    whyWrong: 'El fondo de emergencia no es para gustos: es solo para imprevistos.'
  - question: "Si tu sueldo es $1.800.000, \xBFcu\xE1nto deber\xEDas ahorrar al mes
      con la regla 50/30/20?"
    options:
    - $180.000
    - $360.000
    - $900.000
    correctIndex: 1
    whyCorrect: 'Correcto: el 20% de $1.800.000 es $360.000.'
    whyWrong: "El 20% de $1.800.000 es $360.000 (el 50% ser\xEDan $900.000 y el 10%,
      $180.000)."
  solvedMark: {fileID: 1347351995}
  placeName: el banco (reto final)
