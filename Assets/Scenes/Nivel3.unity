  m_IsActive: 1
--- !u!114 &1923022854
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1923022853}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6306c983440c6ed429a1dca7b3017f9b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "Lleg\xF3 fin de mes, Valentina. Ma\xF1ana se paga el arriendo y es hora
      de demostrar lo que aprendi\xF3."
  - speakerName: Valentina
    nameColor: {r: 0.9098039, g: 0.74509805, b: 0.28235295, a: 1}
    text: "Estoy lista, don Rafael. \xBFQu\xE9 tengo que hacer?"
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: 'Junte 7 monedas, decida bien en la tienda y supere el reto del banco:
      son 3 preguntas. Tiene 2 minutos y medio y solo 1 pista.'
  - speakerName: Valentina
    nameColor: {r: 0.9098039, g: 0.74509805, b: 0.28235295, a: 1}
    text: "Primero se ahorra y despu\xE9s se gasta. \xA1Vamos!"
  missionCompleteConversation:
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "\xA1Lo logr\xF3, Valentina! Sobrevivi\xF3 a su primer mes de independencia."
  - speakerName: Valentina
    nameColor: {r: 0.9098039, g: 0.74509805, b: 0.28235295, a: 1}
    text: "Ahorr\xE9, pagu\xE9 el arriendo y no ca\xED en deudas. \xA1Me siento orgullosa!"
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: 'Y eso le va a servir toda la vida: presupuesto, ahorro y cero deudas innecesarias.'
  reminderConversation:
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "\xA1R\xE1pido, que se acaba el mes! Mire su objetivo arriba a la izquierda."
  dialoguePanel: {fileID: 382009471}
  nameText: {fileID: 544683808}
  contentText: {fileID: 844511831}
  interactionPrompt: {fileID: 1152885280}
