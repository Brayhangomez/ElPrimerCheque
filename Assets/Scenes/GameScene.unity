--- !u!114 &1127212882
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1127212881}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6306c983440c6ed429a1dca7b3017f9b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "\xA1Buenas, Valentina! Bienvenida al edificio. Recuerde que el arriendo
      se paga el primer d\xEDa de cada mes."
  - speakerName: Valentina
    nameColor: {r: 0.9098039, g: 0.74509805, b: 0.28235295, a: 1}
    text: "S\xED, don Rafael. Hoy me pagaron mi primer sueldo... \xA1y ya me lo quiero
      gastar todo!"
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: 'Cuidado con eso, mija. Use la regla 50/30/20: 50% para necesidades, 30%
      para gustos y 20% para ahorrar.'
  - speakerName: Valentina
    nameColor: {r: 0.9098039, g: 0.74509805, b: 0.28235295, a: 1}
    text: "\xBFY ese 20% para qu\xE9 me sirve?"
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "Para su fondo de emergencia. Junte 5 monedas de ahorro por el barrio y
      pase por la tienda y el banco: all\xE1 la van a poner a prueba."
  - speakerName: Valentina
    nameColor: {r: 0.9098039, g: 0.74509805, b: 0.28235295, a: 1}
    text: "\xA1Entendido! Voy por esas monedas."
  missionCompleteConversation:
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "\xA1Lo logr\xF3! Con ese fondo de emergencia ya est\xE1 preparada para
      cualquier imprevisto."
  - speakerName: Valentina
    nameColor: {r: 0.9098039, g: 0.74509805, b: 0.28235295, a: 1}
    text: "Y sin endeudarme con la tarjeta. \xA1Mi primer mes va muy bien!"
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "As\xED es: primero se ahorra y despu\xE9s se gasta. Ahora viene la quincena...
      ah\xED s\xED toca apretarse."
  reminderConversation:
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "\xBFC\xF3mo va? Todav\xEDa le falta algo: mire su objetivo arriba a la
      izquierda. Si se pierde, presione H para una pista."
  dialoguePanel: {fileID: 142883106}
  nameText: {fileID: 2005325575}
  contentText: {fileID: 6748174}
  interactionPrompt: {fileID: 618869357}
