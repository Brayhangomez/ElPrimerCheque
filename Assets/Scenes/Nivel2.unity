  m_IsActive: 1
--- !u!114 &1646826840
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1646826839}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6306c983440c6ed429a1dca7b3017f9b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  conversation:
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "Valentina, ya pag\xF3 el arriendo, muy bien. Pero ahora le quedan 15 d\xEDas
      con poquita plata."
  - speakerName: Valentina
    nameColor: {r: 0.9098039, g: 0.74509805, b: 0.28235295, a: 1}
    text: "S\xED... y Camila me est\xE1 invitando a un concierto este fin de semana."
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "Pi\xE9nselo bien. Junte 6 monedas para el ahorro y decida bien en la tienda
      y en el banco. Tiene 4 minutos y 3 vidas: cada mala decisi\xF3n le cuesta una."
  - speakerName: Valentina
    nameColor: {r: 0.9098039, g: 0.74509805, b: 0.28235295, a: 1}
    text: "\xA1Listo! Esta quincena no me coge desprevenida."
  missionCompleteConversation:
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "\xA1Bien administrada esa quincena! Ahorr\xF3 y no se endeud\xF3."
  - speakerName: Valentina
    nameColor: {r: 0.9098039, g: 0.74509805, b: 0.28235295, a: 1}
    text: "Y hasta le propuse a Camila un plan m\xE1s barato. \xA1Nos fue genial!"
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: 'Eso es saber decir que no a tiempo. Pero ojo: se viene fin de mes...'
  reminderConversation:
  - speakerName: Don Rafael
    nameColor: {r: 0.9490196, g: 0.9019608, b: 0.8156863, a: 1}
    text: "Todav\xEDa le falta: revise su objetivo. Tranquila, el reloj se detiene
      mientras lee o habla."
  dialoguePanel: {fileID: 422203636}
  nameText: {fileID: 1386724508}
  contentText: {fileID: 1412133846}
  interactionPrompt: {fileID: 966618691}
